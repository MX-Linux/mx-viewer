#!/usr/bin/env bash
set -eu
shopt -s nullglob

script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
project_dir=$(dirname -- "$script_dir")
app=mx-viewer

if ! command -v tx >/dev/null; then
    echo "Transifex client (tx) is required to refresh translations." >&2
    exit 1
fi
for lupdate in lupdate lupdate-qt6 /usr/lib/qt6/bin/lupdate /usr/bin/lupdate /usr/local/bin/lupdate; do
    if command -v "$lupdate" >/dev/null; then
        break
    fi
done
if ! command -v "$lupdate" >/dev/null; then
    echo "Qt lupdate is required to refresh translations." >&2
    exit 1
fi

# Keep the same depth as translations/ so lupdate writes the correct relative source locations.
stage=$(mktemp -d "$project_dir/.translations.XXXXXXXX")
trap 'rm -rf -- "$stage"' EXIT
cd "$stage"
mkdir .tx
if [[ -s "$script_dir/.tx/config" ]]; then
    cp -- "$script_dir/.tx/config" .tx/config
    if ! grep -q '^minimum_perc' .tx/config; then
        echo "minimum_perc = 25" >> .tx/config
    fi
else
    cat > .tx/config <<EOF
[main]
host = https://www.transifex.com

[o:anticapitalista:p:antix-development:r:$app]
file_filter = ./${app}_<lang>.ts
source_file = ${app}_en.ts
source_lang = en
type = ts
minimum_perc = 25
EOF
fi

cp -- "$script_dir/${app}_en.ts" .
tx pull -r "antix-development.$app" --all
rm -f -- "${app}_en_US.ts"
catalogs=("${app}_"*.ts)
if (( ${#catalogs[@]} < 2 )); then
    echo "Transifex returned no translated catalogs." >&2
    exit 1
fi
"$lupdate" "$project_dir/src" -ts "${app}_en.ts"

# Install the refreshed set before retiring languages no longer supplied by Transifex.
obsolete=()
for old in "$script_dir/${app}_"*.ts; do
    if [[ ! -f "${old##*/}" ]]; then
        obsolete+=("$old")
    fi
done
mv -- "${catalogs[@]}" "$script_dir/"
rm -f -- "${obsolete[@]}"
